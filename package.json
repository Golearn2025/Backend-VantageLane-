{
  "name": "vantage-lane-pricing-backend",
  "version": "1.0.0",
  "description": "Backend system for Vantage Lane ride booking pricing calculations",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "clean": "rimraf dist",
    "test:pricing-validation": "npx ts-node tests/pricing-validation/pricingValidation.test.ts",
    "test:quote-economics": "npx ts-node tests/pricing-validation/quoteEconomicsMapper.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-validator": "^3.0.0",
    "@types/node": "^20.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "stripe": "^20.4.1",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "pricing",
    "backend",
    "api",
    "booking",
    "transportation"
  ],
  "author": "Vantage Lane",
  "license": "MIT"
}
